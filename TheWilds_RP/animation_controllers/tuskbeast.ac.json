{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.wilds.tuskbeast.move": {
      "initial_state": "idle",
      "states": {
        "idle": {
          "animations": [
            {
              "savanna_tuskbeast.idle": "q.mark_variant == 0 && q.variant == 0 && q.skin_id != 1"
            },
            {
              "savanna_tuskbeast_armored.idle": "q.mark_variant == 0 && q.variant == 1 && q.skin_id != 1"
            },
            {
              "badlands_tuskbeast.idle": "q.mark_variant == 1 && q.variant == 0 && q.skin_id != 1"
            },
            {
              "badlands_tuskbeast_armored.idle": "q.mark_variant == 1 && q.variant == 1 && q.skin_id != 1"
            },
            {
              "tundra_tuskbeast.idle": "q.mark_variant == 2 && q.variant == 0 && q.skin_id != 1"
            },
            {
              "tundra_tuskbeast_armored.idle": "q.mark_variant == 2 && q.variant == 1 && q.skin_id != 1"
            },
            {
              "savanna_tuskbeast.wounded_idle": "q.mark_variant == 0 && q.variant == 0 && q.skin_id == 1"
            },
            {
              "savanna_tuskbeast_armored.wounded_idle": "q.mark_variant == 0 && q.variant == 1 && q.skin_id == 1"
            },
            {
              "badlands_tuskbeast.wounded_idle": "q.mark_variant == 1 && q.variant == 0 && q.skin_id == 1"
            },
            {
              "badlands_tuskbeast_armored.wounded_idle": "q.mark_variant == 1 && q.variant == 1 && q.skin_id == 1"
            },
            {
              "tundra_tuskbeast.wounded_idle": "q.mark_variant == 2 && q.variant == 0 && q.skin_id == 1"
            },
            {
              "tundra_tuskbeast_armored.wounded_idle": "q.mark_variant == 2 && q.variant == 1 && q.skin_id == 1"
            }
          ],
          "blend_transition": 0.3,
          "transitions": [
            {
              "dead": "!q.is_alive"
            },
            {
              "walk": "q.modified_move_speed > 0.05"
            }
          ]
        },
        "walk": {
          "animations": [
            {
              "savanna_tuskbeast.walk": "q.mark_variant == 0 && q.variant == 0 && q.skin_id != 1"
            },
            {
              "savanna_tuskbeast_armored.walk": "q.mark_variant == 0 && q.variant == 1 && q.skin_id != 1"
            },
            {
              "badlands_tuskbeast.walk": "q.mark_variant == 1 && q.variant == 0 && q.skin_id != 1"
            },
            {
              "badlands_tuskbeast_armored.walk": "q.mark_variant == 1 && q.variant == 1 && q.skin_id != 1"
            },
            {
              "tundra_tuskbeast.walk": "q.mark_variant == 2 && q.variant == 0 && q.skin_id != 1"
            },
            {
              "tundra_tuskbeast_armored.walk": "q.mark_variant == 2 && q.variant == 1 && q.skin_id != 1"
            },
            {
              "savanna_tuskbeast.wounded_walk": "q.mark_variant == 0 && q.variant == 0 && q.skin_id == 1"
            },
            {
              "savanna_tuskbeast_armored.wounded_walk": "q.mark_variant == 0 && q.variant == 1 && q.skin_id == 1"
            },
            {
              "badlands_tuskbeast.wounded_walk": "q.mark_variant == 1 && q.variant == 0 && q.skin_id == 1"
            },
            {
              "badlands_tuskbeast_armored.wounded_walk": "q.mark_variant == 1 && q.variant == 1 && q.skin_id == 1"
            },
            {
              "tundra_tuskbeast.wounded_walk": "q.mark_variant == 2 && q.variant == 0 && q.skin_id == 1"
            },
            {
              "tundra_tuskbeast_armored.wounded_walk": "q.mark_variant == 2 && q.variant == 1 && q.skin_id == 1"
            }
          ],
          "blend_transition": 0.3,
          "transitions": [
            {
              "dead": "!q.is_alive"
            },
            {
              "idle": "q.modified_move_speed <= 0.05"
            }
          ]
        },
        "dead": {
          "animations": [
            {
              "savanna_tuskbeast.death": "q.mark_variant == 0 && q.variant == 0"
            },
            {
              "savanna_tuskbeast_armored.death": "q.mark_variant == 0 && q.variant == 1"
            },
            {
              "badlands_tuskbeast.death": "q.mark_variant == 1 && q.variant == 0"
            },
            {
              "badlands_tuskbeast_armored.death": "q.mark_variant == 1 && q.variant == 1"
            },
            {
              "tundra_tuskbeast.death": "q.mark_variant == 2 && q.variant == 0"
            },
            {
              "tundra_tuskbeast_armored.death": "q.mark_variant == 2 && q.variant == 1"
            }
          ]
        }
      }
    },
    "controller.animation.wilds.tuskbeast.hurt": {
      "initial_state": "default",
      "states": {
        "default": {
          "transitions": [
            {
              "hurt": "q.hurt_time > 0 && q.is_alive"
            }
          ]
        },
        "hurt": {
          "animations": [
            {
              "savanna_tuskbeast.hurt": "q.mark_variant == 0 && q.variant == 0"
            },
            {
              "savanna_tuskbeast_armored.hurt": "q.mark_variant == 0 && q.variant == 1"
            },
            {
              "badlands_tuskbeast.hurt": "q.mark_variant == 1 && q.variant == 0"
            },
            {
              "badlands_tuskbeast_armored.hurt": "q.mark_variant == 1 && q.variant == 1"
            },
            {
              "tundra_tuskbeast.hurt": "q.mark_variant == 2 && q.variant == 0"
            },
            {
              "tundra_tuskbeast_armored.hurt": "q.mark_variant == 2 && q.variant == 1"
            }
          ],
          "transitions": [
            {
              "default": "q.all_animations_finished"
            }
          ]
        }
      }
    }
  }
}
