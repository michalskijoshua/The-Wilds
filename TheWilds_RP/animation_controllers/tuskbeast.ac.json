{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.wilds.tuskbeast.move": {
      "initial_state": "idle",
      "states": {
        "idle": {
          "animations": ["idle"],
          "blend_transition": 0.3,
          "transitions": [
            { "dead": "!query.is_alive" },
            { "walk": "query.modified_move_speed > 0.05" }
          ]
        },
        "walk": {
          "animations": ["walk"],
          "blend_transition": 0.3,
          "transitions": [
            { "dead": "!query.is_alive" },
            { "idle": "query.modified_move_speed <= 0.05" }
          ]
        },
        "dead": {
          "animations": ["death"]
        }
      }
    },
    "controller.animation.wilds.tuskbeast.hurt": {
      "initial_state": "default",
      "states": {
        "default": {
          "transitions": [{ "hurt": "query.hurt_time > 0 && query.is_alive" }]
        },
        "hurt": {
          "animations": ["hurt"],
          "transitions": [{ "default": "query.all_animations_finished" }]
        }
      }
    }
  }
}
