{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.wilds.pebble_mimic": {
      "initial_state": "idle",
      "states": {
        "idle": {
          "animations": [
            {
              "stone.idle": "q.mark_variant == 0"
            },
            {
              "mossy.idle": "q.mark_variant == 1"
            },
            {
              "sand.idle": "q.mark_variant == 2"
            },
            {
              "clay.idle": "q.mark_variant == 3"
            },
            {
              "coal.idle": "q.mark_variant == 4"
            },
            {
              "copper.idle": "q.mark_variant == 5"
            },
            {
              "iron.idle": "q.mark_variant == 6"
            },
            {
              "gold.idle": "q.mark_variant == 7"
            },
            {
              "diamond.idle": "q.mark_variant == 8"
            },
            {
              "netherite.idle": "q.mark_variant == 9"
            }
          ],
          "blend_transition": 0.25,
          "transitions": [
            {
              "dead": "!q.is_alive"
            },
            {
              "hurt": "q.hurt_time > 0"
            },
            {
              "walk": "q.modified_move_speed > 0.05"
            }
          ]
        },
        "walk": {
          "animations": [
