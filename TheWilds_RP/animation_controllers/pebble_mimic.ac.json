            },
            {
              "diamond.walk": "q.mark_variant == 8"
            },
            {
              "netherite.walk": "q.mark_variant == 9"
            }
          ],
          "blend_transition": 0.25,
          "transitions": [
            {
              "dead": "!q.is_alive"
            },
            {
              "hurt": "q.hurt_time > 0"
            },
            {
              "idle": "q.modified_move_speed <= 0.05"
